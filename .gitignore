# 敏感配置：包含资金账号、QMT 路径、webhook token，绝不入库
config/config.yaml
config/*.local.yaml
.env

# QMT 客户端导出的账户文件（<资金账号>_<席位>_<类型>.csv）。
# 内含资金账号、余额、持仓明细与成交流水 —— 运行 miniQMT 时会自动
# 落在工作目录，很容易被 git add -A 顺手带进提交
[0-9]*_[0-9]*_*.csv

# 数据与日志
data/
logs/
*.db
*.sqlite3

# 回测产物 —— 保留报告目录的关键结果
# 大文件（parquet/html）不入库，csv 结果入库
reports/**/*.parquet
reports/**/*.html
*.parquet
*.html
!docs/*.html
!reports/**/*.csv

# 策略目录的模型产物必须入库（走 LFS，见 .gitattributes）。
# 教训：scores.parquet 曾被这里的 *.parquet 规则挡在库外，
# 重训覆盖后那份产生 +44.37% 回测的分数永久丢失，结果无法复现。
!strategies/**/models/*.parquet
!strategies/**/models/*.zip
!strategies/**/models/*.pt

# 但**中间缓存不算产物**。features_*.pkl 是 Alpha158 的计算缓存，
# 1.6 GB 一份，且每次改因子都会重写。它曾以普通 git 对象进了两次历史
# （1644 MB + 1568 MB），把 .git 撑到 2.3 GB，并且超过 GitHub 的
# 100 MB 单文件上限，导致整个仓库推不上去。
#
# 判断标准：能从源数据重算出来的就不入库。这份缓存 20 分钟可重建，
# 而 scores.parquet 是训练结果、重训即永久丢失，两者性质不同。
strategies/**/models/features_*.pkl
strategies/**/models/*_cache.pkl

# 策略运行时状态：回撤峰值是本机实盘记录，不该跟着代码走。
# 换机器要手动迁移，删掉等于抹掉回撤记忆（见 drawdown.py）
strategies/**/state/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# 研究脚本产出
research/__pycache__/

# Qlib / mlflow 实验产物
mlruns/

# 管理台的运行日志与任务索引（本机运行痕迹，不入库）
webui/jobs/
webui/schedules.json

# 实盘执行记录（含真实持仓与委托，不入库）
strategies/**/executions/
strategies/**/state/positions.json
data/clean/
data/market.db*
strategies/**/state/live_equity.csv
data/announcement/
data/universe/st_history.parquet
